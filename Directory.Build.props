<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Partas.AnimeJs' and '$(MSBuildProjectName)' != 'Partas.AnimeJs.Tests' and '$(MSBuildProjectName)' != 'Tests'">
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Partas.AnimeJs' and '$(MSBuildProjectName)' != 'Partas.AnimeJs.Tests' and '$(MSBuildProjectName)' != 'Tests'">
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
