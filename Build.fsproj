<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><UseCentralPackages>true</UseCentralPackages><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup><Compile Include="Build/Paths.fs" /><Compile Include="Build/Stages.fs" /><Compile Include="Build/Commands.fs" /><Compile Include="Build/Program.fs" /></ItemGroup>
  <ItemGroup><PackageReference Include="Partas.Build" /><PackageReference Include="Partas.Build.Baked" /><ProjectReference Include="tools/Partas.AnimeJs.Generation/Partas.AnimeJs.Generation.fsproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="Xantham.Fable.Core.TS" GeneratePathProperty="true" /></ItemGroup>
  <ItemGroup><None Include="$(PkgXantham_Fable_Core_TS)/lib/net8.0/Xantham.Fable.Core.TS.xml" CopyToOutputDirectory="PreserveNewest" Link="Xantham.Fable.Core.TS.xml" /></ItemGroup>
</Project>
