<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <FablePackageType>library</FablePackageType>
        <TargetFramework>net9.0</TargetFramework>
        <IsTrimmable>false</IsTrimmable>
        <IsAotCompatible>false</IsAotCompatible>
        <PackageId>Partas.AnimeJs</PackageId>
        <Title>Partas.AnimeJs</Title>
        <RootNamespace>Partas.AnimeJs</RootNamespace>
        <AssemblyName>Partas.AnimeJs</AssemblyName>
        <Company>F# Community</Company>
        <Description>Generated, typed AnimeJs DSL for Fable F#, sharing Xantham CSS and DOM types</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/shayanhabibi/Partas.AnimeJs</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>Partas;F#;FSharp;Fable;fable-javascript;Web;animejs;animation;ce</PackageTags>
        <Authors>Shayan Habibi</Authors>
        <Copyright>Copyright (c) Shayan Habibi 2025</Copyright>
        <Version>0.1.1</Version>
        <PackageVersion>0.1.1</PackageVersion>
        <PackageReleaseNotes>Ships a flat fable/Partas.AnimeJs.fsproj, so Fable compiles the package sources (0.1.0 listed them behind an MSBuild import Fable does not follow).</PackageReleaseNotes>
        <NpmDependencies>
            <NpmPackage Name="animejs" Version="4.5.0" />
        </NpmDependencies>
    </PropertyGroup>
    <ItemGroup>
        <None Include="package.json" />
        <None Include="Generated/Generated.props" Pack="true" PackagePath="fable/Generated/Generated.props" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Fable.Core" />
      <PackageReference Include="Xantham.Fable.Core" />
      <PackageReference Include="Xantham.Fable.Core.TS" />
        <PackageReference Include="Fable.Package.SDK">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <Import Project="Generated/Generated.props" />
    <Target Name="UseGeneratedFablePackageProject" AfterTargets="CreateFablePackageFiles">
      <ItemGroup>
        <_PackageFiles Remove="$(MSBuildProjectFullPath)" />
        <_PackageFiles Include="Generated/Package.fsproj" Pack="true" PackagePath="fable/Partas.AnimeJs.fsproj" BuildAction="None" />
      </ItemGroup>
    </Target>
</Project>
