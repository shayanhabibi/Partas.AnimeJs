<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="xantham" value="https://nuget.cloudsmith.io/shayanhabibi/xantham/v3/index.json" />
    <add key="partas" value="https://nuget.cloudsmith.io/shayanhabibi/shayanhabibi-partas-build/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="xantham"><package pattern="xantham" /><package pattern="Xantham.*" /></packageSource>
    <packageSource key="partas"><package pattern="Partas.Build" /><package pattern="Partas.Build.*" /></packageSource>
  </packageSourceMapping>
</configuration>
